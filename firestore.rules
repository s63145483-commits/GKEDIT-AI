rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified operations
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based Creator Admin: strictly verifies authenticated email against admin identifier
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email == "narsimha2141@gmail.com";
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000)) &&
        (!('role' in data) || (data.role is string && data.role in ['creator', 'editor', 'developer', 'explorer', 'admin', 'user'])) &&
        (!('location' in data) || (data.location is map)) &&
        (!('device' in data) || (data.device is map)) &&
        (!('behaviorProfile' in data) || (data.behaviorProfile is map));
    }

    function isValidUserSettings(data) {
      return data.keys().hasOnly(['biometricEnabled', 'wakeWordEnabled', 'theme', 'updatedAt']) &&
        (!('biometricEnabled' in data) || data.biometricEnabled is bool) &&
        (!('wakeWordEnabled' in data) || data.wakeWordEnabled is bool) &&
        (!('theme' in data) || (data.theme is string && data.theme.size() <= 50));
    }

    // Users Collection:
    // - Standard users can ONLY get and write (create/update) their own document (request.auth.uid == userId)
    // - Collection-wide list queries are strictly reserved exclusively for the administrator account
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == userId &&
                       incoming().lastActive == request.time;
      allow update: if isValidId(userId) &&
                       (isOwner(userId) || isAdmin()) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().lastActive == request.time;
      allow delete: if isValidId(userId) && isAdmin();

      // User Private Settings Subcollection
      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create, update: if isValidId(userId) &&
                                 isValidId(settingId) &&
                                 (isOwner(userId) || isAdmin()) &&
                                 isValidUserSettings(incoming()) &&
                                 incoming().updatedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(settingId) && (isOwner(userId) || isAdmin());
      }
    }

    // Admin Audit Sessions Collection:
    // Records immutable administrator monitor access sessions for security compliance.
    // Strictly restricted to authenticated administrator.
    match /admin_audit_sessions/{sessionId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(sessionId);
      allow delete: if false; // Immutable audit trail
    }
  }
}
